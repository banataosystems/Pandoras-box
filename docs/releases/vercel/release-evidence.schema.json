{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/banataosystems/Pandoras-box/docs/releases/vercel/release-evidence.schema.json",
  "title": "Pandora externally anchored release evidence",
  "description": "Source-controlled candidate metadata cannot satisfy provider, independent-reviewer, or owner-authorization gates. Positive release claims require fresh external receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "candidate", "evidence", "derived"],
  "properties": {
    "packet_version": {"const": "2.0.0"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request", "branch", "sha", "tree_sha", "base_sha", "observed_at"],
      "properties": {
        "repository": {"const": "banataosystems/Pandoras-box"},
        "pull_request": {"const": 58},
        "branch": {"const": "release/vercel-promotion-recovery-20260819"},
        "sha": {"pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"pattern": "^[0-9a-f]{40}$"},
        "base_sha": {"pattern": "^[0-9a-f]{40}$"},
        "observed_at": {"format": "date-time"}
      }
    },
    "evidence": {"type": "array"},
    "derived": {"type": "object"}
  }
}
