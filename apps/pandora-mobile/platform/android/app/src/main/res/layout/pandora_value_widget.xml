<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pandora_value_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pandora_value_widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="PANDORA VALUE"
            android:textColor="@color/pandora_value_widget_text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pandora_value_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="—"
                android:textColor="@color/pandora_value_widget_text"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/pandora_value_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="2dp"
                android:textColor="@color/pandora_value_widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pandora_value_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progressDrawable="@drawable/pandora_value_widget_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pandora_value_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Not measured yet"
            android:textColor="@color/pandora_value_widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pandora_value_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Waiting for fresh verified customer-value evidence"
            android:textColor="@color/pandora_value_widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/pandora_value_freshness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No verified value reading"
            android:textColor="@color/pandora_value_widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
