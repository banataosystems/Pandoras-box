{
  "schema_version": "1.0.0",
  "repository": {
    "full_name": "banataosystems/Pandoras-box",
    "repository_id": 1326729533,
    "default_branch": "main"
  },
  "authority": {
    "provider_mechanism": "classic_branch_protection",
    "policy_path": ".github/governance/main-policy.json",
    "provider_payload_path": ".github/branch-protection/main.json",
    "drift_validator_path": "scripts/check-github-governance-provider.mjs"
  },
  "pull_request": {
    "required": true,
    "required_approving_review_count": 1,
    "dismiss_stale_reviews": true,
    "require_last_push_approval": true,
    "require_conversation_resolution": true,
    "require_code_owner_reviews": false,
    "independent_review": {
      "required": true,
      "bind_to_current_head": true,
      "author_or_last_pusher_cannot_supply": true
    }
  },
  "status_checks": {
    "strict": true,
    "required_contexts": [
      {
        "context": "Protected main exact-head gate",
        "workflow": ".github/workflows/protected-main-governance.yml",
        "job": "required",
        "runs_on_every_pull_request": true,
        "binds_exact_head": true
      }
    ]
  },
  "main_branch": {
    "enforce_admins": true,
    "required_linear_history": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "block_creations": false,
    "lock_branch": false,
    "allow_fork_syncing": false
  },
  "repository_settings": {
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "allow_update_branch": true,
    "delete_branch_on_merge": false
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "bypass": {
    "actors": [],
    "normal_bypass_allowed": false,
    "break_glass": {
      "provider_policy_change_required": true,
      "criteria": "A verified production incident where the protected path itself prevents the least-risk repair.",
      "evidence_required": [
        "incident identifier",
        "exact before-state provider readback",
        "bounded mutation plan",
        "owner authorization",
        "exact after-state provider readback",
        "restoration readback",
        "post-incident review"
      ]
    }
  }
}
